# Normalise line endings on commit
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binaries — never touch
*.png binary
*.jpg binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
